# Karma's World - Environment Configuration Example
# Copy this file to .env in relevant workspaces for local configuration.
# Never commit actual credentials or secrets to source control.

# ==============================================================================
# Web Frontend (Vite)
# ==============================================================================
# Port for the Vite development server (default: 5173)
PORT=5173
# Backend API proxy target (default: http://127.0.0.1:4000)
VITE_API_URL=http://localhost:4000

# ==============================================================================
# Backend API (Express + Prisma) - See server/.env.example for details
# ==============================================================================
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://karma:localdev-only@localhost:5432/karmas_world?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters-for-session-encryption

# SMTP / Mailer Settings (Mailpit for local testing)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@karmas.world

# Production MFA Encryption Key (32-byte hex string)
# MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

