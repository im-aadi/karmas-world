# ==============================================================================
# Karma's World - Production Environment Configuration Template (Phase 12)
# ==============================================================================
# Copy this file to .env.production on your production server.
# Ensure all secrets are cryptographically random strings (e.g. openssl rand -hex 32).

# Application Environment
NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://karmas.world

# PostgreSQL Database Connection
# In Docker Compose, the database host matches the service name: 'database'
DATABASE_URL=postgresql://karma:REPLACE_WITH_STRONG_DB_PASSWORD@database:5432/karmas_world?schema=public

# Session Secret (Minimum 32 characters, cryptographically random)
SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_RANDOM_SESSION_SECRET_KEY_ABC1234567890

# MFA Encryption Key (Exactly 64 hex characters for AES-256-GCM encryption)
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SMTP Mail Server Configuration (Required in production for email verification & alerts)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=REPLACE_WITH_SMTP_PROVIDER_API_KEY
SMTP_FROM=no-reply@karmas.world

# Docker Compose Service Credentials
POSTGRES_USER=karma
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=karmas_world
HTTP_PORT=80
