{
  "name": "karmas-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "shared:build": "tsc -p packages/shared/tsconfig.json",
    "api:dev": "pnpm --filter @karmas-world/api dev",
    "api:build": "pnpm --filter @karmas-world/api build",
    "api:test": "pnpm --filter @karmas-world/api test",
    "db:up": "docker compose up -d database",
    "db:down": "docker compose down",
    "build:all": "pnpm shared:build && pnpm build && pnpm api:build",
    "test:all": "pnpm test && pnpm api:test"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.2",
    "vitest": "^2.1.8"
  }
}
