generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  LEARNER
  ADMIN
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CommunityPostStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum CommunityReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum SecurityUpdateType {
  LEARNING_GUIDE
  RESEARCH_UPDATE
  SECURITY_ADVISORY
}

enum SecurityUpdateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AccountTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
}

enum SecurityEventType {
  SIGN_IN
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGED
  MFA_ENABLED
  MFA_DISABLED
  RECOVERY_CODES_ROTATED
  SESSION_REVOKED
  OTHER_SESSIONS_REVOKED
}

model User {
  id                        String              @id @default(cuid())
  displayName               String              @db.VarChar(60)
  email                     String              @unique @db.VarChar(254)
  passwordHash              String              @db.VarChar(255)
  role                      UserRole            @default(LEARNER)
  leaderboardOptIn          Boolean             @default(false)
  emailVerifiedAt           DateTime?
  mfaEnabledAt              DateTime?
  mfaSecretEncrypted        String?             @db.VarChar(256)
  mfaPendingSecretEncrypted String?             @db.VarChar(256)
  mfaPendingExpiresAt       DateTime?
  mfaLastAcceptedStep       BigInt?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  progress                  LessonProgress[]
  authoredPosts             CommunityPost[]     @relation("CommunityPostAuthor")
  moderatedPosts            CommunityPost[]     @relation("CommunityPostModerator")
  submittedReports          CommunityReport[]   @relation("CommunityReportAuthor")
  reviewedReports           CommunityReport[]   @relation("CommunityReportModerator")
  authoredSecurityUpdates   SecurityUpdate[]    @relation("SecurityUpdateAuthor")
  editedSecurityUpdates     SecurityUpdate[]    @relation("SecurityUpdateEditor")
  accountTokens             AccountToken[]
  mfaRecoveryCodes          MfaRecoveryCode[]
  securityEvents            SecurityEvent[]
  enrollments               Enrollment[]
  bookmarks                 Bookmark[]
  userAchievements          UserAchievement[]
  streak                    LearningStreak?
  labAttempts               LabAttempt[]
  totalXp                   Int                         @default(0)
  xpTransactions            XPTransaction[]
  weeklyClaims              UserWeeklyChallengeClaim[]
  quizAttempts              QuizAttempt[]
  forumThreads              ForumThread[]               @relation("ForumThreadAuthor")
  forumReplies              ForumReply[]                @relation("ForumReplyAuthor")
  forumVotes                ForumVote[]                 @relation("ForumVoteUser")
  knowledgeArticles         KnowledgeArticle[]          @relation("KnowledgeArticleAuthor")
}

model SecurityEvent {
  id        String            @id @default(cuid())
  userId    String
  type      SecurityEventType
  userAgent String?           @db.VarChar(240)
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AccountToken {
  id          String              @id @default(cuid())
  userId      String
  purpose     AccountTokenPurpose
  tokenHash   String              @unique @db.VarChar(64)
  targetEmail String?             @db.VarChar(254)
  expiresAt   DateTime
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model MfaRecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @unique @db.VarChar(64)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  courseId    String   @db.VarChar(40)
  lessonIndex Int
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, lessonIndex])
  @@index([userId, completedAt])
}

model Category {
  id          String          @id @default(cuid())
  slug        String          @unique @db.VarChar(60)
  name        String          @db.VarChar(120)
  description String          @db.VarChar(600)
  level       DifficultyLevel @default(BEGINNER)
  iconName    String          @db.VarChar(60)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  courses     Course[]

  @@index([slug])
}

model Course {
  id          String          @id @default(cuid())
  slug        String          @unique @db.VarChar(80)
  title       String          @db.VarChar(180)
  description String          @db.VarChar(1000)
  level       DifficultyLevel @default(BEGINNER)
  duration    String          @db.VarChar(40)
  xpReward    Int             @default(100)
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modules     Module[]
  enrollments Enrollment[]
  quizzes     Quiz[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([categoryId])
  @@index([slug])
}

model Module {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String   @db.VarChar(180)
  orderIndex Int      @default(0)
  lessons    Lesson[]

  @@index([courseId, orderIndex])
}

model Lesson {
  id         String     @id @default(cuid())
  moduleId   String
  module     Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title      String     @db.VarChar(180)
  slug       String     @unique @db.VarChar(120)
  duration   String     @db.VarChar(40)
  content    String     @db.Text
  orderIndex Int        @default(0)
  xpReward   Int        @default(50)
  bookmarks  Bookmark[]

  @@index([moduleId, orderIndex])
  @@index([slug])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
  @@index([userId, enrolledAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
}

model Achievement {
  id               String            @id @default(cuid())
  slug             String            @unique @db.VarChar(60)
  title            String            @db.VarChar(120)
  description      String            @db.VarChar(300)
  icon             String            @db.VarChar(60)
  xpValue          Int               @default(100)
  createdAt        DateTime          @default(now())
  userAchievements UserAchievement[]

  @@index([slug])
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

model LearningStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CommunityPost {
  id          String              @id @default(cuid())
  authorId    String
  body        String              @db.VarChar(800)
  status      CommunityPostStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  moderatedAt DateTime?
  moderatorId String?
  author      User                @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  moderator   User?               @relation("CommunityPostModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  reports     CommunityReport[]

  @@index([status, createdAt])
  @@index([authorId, createdAt])
}

model CommunityReport {
  id          String                @id @default(cuid())
  postId      String
  reporterId  String
  reason      String                @db.VarChar(40)
  details     String?               @db.VarChar(300)
  status      CommunityReportStatus @default(OPEN)
  createdAt   DateTime              @default(now())
  reviewedAt  DateTime?
  moderatorId String?
  post        CommunityPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter    User                  @relation("CommunityReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator   User?                 @relation("CommunityReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@unique([postId, reporterId])
  @@index([status, createdAt])
}

model SecurityUpdate {
  id                String               @id @default(cuid())
  source            String               @db.VarChar(20)
  type              SecurityUpdateType
  title             String               @db.VarChar(180)
  sourceUrl         String               @db.VarChar(2048)
  sourcePublishedAt DateTime
  summary           String               @db.VarChar(600)
  takeaway          String               @db.VarChar(360)
  status            SecurityUpdateStatus @default(DRAFT)
  verifiedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  authorId          String?
  editorId          String?
  author            User?                @relation("SecurityUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  editor            User?                @relation("SecurityUpdateEditor", fields: [editorId], references: [id], onDelete: SetNull)

  @@index([status, sourcePublishedAt])
}

model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.JsonB
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_user_sessions_expire")
  @@map("user_sessions")
}

model Lab {
  id           String          @id @default(cuid())
  slug         String          @unique @db.VarChar(80)
  title        String          @db.VarChar(180)
  description  String          @db.VarChar(1000)
  categorySlug String          @db.VarChar(60)
  difficulty   DifficultyLevel @default(BEGINNER)
  duration     String          @db.VarChar(40)
  xpReward     Int             @default(150)
  type         String          @db.VarChar(40)
  instructions String          @db.Text
  tasks        LabTask[]
  attempts     LabAttempt[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([categorySlug])
  @@index([slug])
}

model LabTask {
  id          String   @id @default(cuid())
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  title       String   @db.VarChar(180)
  instruction String   @db.Text
  hint        String   @db.VarChar(500)
  flagHash    String   @db.VarChar(64)
  orderIndex  Int      @default(0)
  points      Int      @default(50)

  @@index([labId, orderIndex])
}

model LabAttempt {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  labId          String
  lab            Lab       @relation(fields: [labId], references: [id], onDelete: Cascade)
  completedTasks Json      @default("[]") @db.JsonB
  xpAwarded      Int       @default(0)
  status         String    @default("IN_PROGRESS") @db.VarChar(30)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  @@unique([userId, labId])
  @@index([userId, status])
}

model XPTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  source      String   @db.VarChar(60)
  description String   @db.VarChar(240)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model WeeklyChallenge {
  id          String                     @id @default(cuid())
  slug        String                     @unique @db.VarChar(80)
  title       String                     @db.VarChar(180)
  description String                     @db.VarChar(600)
  category    String                     @db.VarChar(60)
  targetCount Int                        @default(1)
  type        String                     @db.VarChar(40)
  xpReward    Int                        @default(250)
  badgeIcon   String                     @db.VarChar(60)
  startsAt    DateTime                   @default(now())
  expiresAt   DateTime
  createdAt   DateTime                   @default(now())
  userClaims  UserWeeklyChallengeClaim[]

  @@index([expiresAt])
}

model UserWeeklyChallengeClaim {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  claimedAt   DateTime        @default(now())

  @@unique([userId, challengeId])
  @@index([userId])
}




model Quiz {
  id            String          @id @default(cuid())
  slug          String          @unique @db.VarChar(80)
  title         String          @db.VarChar(180)
  description   String          @db.VarChar(1000)
  categorySlug  String          @db.VarChar(60)
  difficulty    DifficultyLevel @default(BEGINNER)
  timeLimitMins Int             @default(15)
  passingScore  Int             @default(70)
  xpReward      Int             @default(150)
  courseId      String?
  course        Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questions     QuizQuestion[]
  attempts      QuizAttempt[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([categorySlug])
  @@index([difficulty])
  @@index([slug])
}

model QuizQuestion {
  id          String       @id @default(cuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt      String       @db.Text
  codeSnippet String?      @db.Text
  explanation String       @db.Text
  orderIndex  Int          @default(0)
  points      Int          @default(10)
  options     QuizOption[]

  @@index([quizId, orderIndex])
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String       @db.VarChar(600)
  isCorrect  Boolean      @default(false)
  orderIndex Int          @default(0)

  @@index([questionId, orderIndex])
}

model QuizAttempt {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score         Int
  maxScore      Int
  percentage    Int
  passed        Boolean
  timeSpentSecs Int      @default(0)
  answers       Json     @default("{}") @db.JsonB
  xpAwarded     Int      @default(0)
  startedAt     DateTime @default(now())
  completedAt   DateTime @default(now())

  @@index([userId, quizId])
  @@index([userId, completedAt])
}

model ForumCategory {
  id          String        @id @default(cuid())
  slug        String        @unique @db.VarChar(60)
  name        String        @db.VarChar(120)
  description String        @db.VarChar(500)
  iconName    String        @db.VarChar(60)
  orderIndex  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  threads     ForumThread[]

  @@index([orderIndex])
}

model ForumThread {
  id           String              @id @default(cuid())
  slug         String              @unique @db.VarChar(120)
  title        String              @db.VarChar(200)
  content      String              @db.Text
  categorySlug String              @db.VarChar(60)
  category     ForumCategory       @relation(fields: [categorySlug], references: [slug], onDelete: Cascade)
  authorId     String
  author       User                @relation("ForumThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  isPinned     Boolean             @default(false)
  isLocked     Boolean             @default(false)
  viewsCount   Int                 @default(0)
  upvotesCount Int                 @default(0)
  status       CommunityPostStatus @default(APPROVED)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  replies      ForumReply[]
  votes        ForumVote[]

  @@index([categorySlug, createdAt])
  @@index([authorId])
  @@index([status, createdAt])
}

model ForumReply {
  id               String      @id @default(cuid())
  threadId         String
  thread           ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId         String
  author           User        @relation("ForumReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content          String      @db.Text
  upvotesCount     Int         @default(0)
  isAcceptedAnswer Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  votes            ForumVote[]

  @@index([threadId, createdAt])
  @@index([authorId])
}

model ForumVote {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation("ForumVoteUser", fields: [userId], references: [id], onDelete: Cascade)
  threadId  String?
  thread    ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  replyId   String?
  reply     ForumReply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)
  direction Int          @default(1)
  createdAt DateTime     @default(now())

  @@unique([userId, threadId])
  @@unique([userId, replyId])
  @@index([threadId])
  @@index([replyId])
}

model KnowledgeArticle {
  id                String          @id @default(cuid())
  slug              String          @unique @db.VarChar(120)
  title             String          @db.VarChar(200)
  summary           String          @db.VarChar(600)
  content           String          @db.Text
  categorySlug      String          @db.VarChar(60)
  tags              String          @db.VarChar(240)
  difficulty        DifficultyLevel @default(BEGINNER)
  readTimeMinutes   Int             @default(5)
  authorId          String?
  author            User?           @relation("KnowledgeArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  viewsCount        Int             @default(0)
  helpfulVotesCount Int             @default(0)
  isFeatured        Boolean         @default(false)
  publishedAt       DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([categorySlug, publishedAt])
  @@index([isFeatured])
  @@index([slug])
}
